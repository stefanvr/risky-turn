{
  "rules": {
    "rooms": {
      "$code": {
        // The host may take its own room away and do nothing else at this
        // level: a write that leaves anything behind is refused. This is what
        // lets a finished room be cleared, and what lets onDisconnect clear a
        // room whose host closed the tab without ever connecting.
        ".write": "auth != null && data.child('host/uid').val() === auth.uid && !newData.exists()",

        ".read": "auth != null && (data.child('host/uid').val() === auth.uid || data.child('guest/uid').val() === auth.uid)",

        "host": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
        },

        "guest": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($code).child('host').exists()"
        },

        "offer": {
          ".write": "auth != null && root.child('rooms').child($code).child('host/uid').val() === auth.uid"
        },

        "answer": {
          ".write": "auth != null && root.child('rooms').child($code).child('guest/uid').val() === auth.uid"
        },

        "ice": {
          "$side": {
            ".write": "auth != null && root.child('rooms').child($code).child($side).child('uid').val() === auth.uid"
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
